---
import type { CollectionEntry } from "astro:content";
import ContentCard from "./ContentCard.astro";

interface Props {
  items: CollectionEntry<"items">[];
}

const { items } = Astro.props;
---

<main class="homepage-grid" data-content-grid>
  <article class="persistent-card persistent-card--about">
    <a href={`${import.meta.env.BASE_URL}about/`}>
      <span>About</span>
      <small>Design &amp; art</small>
    </a>
  </article>

  <article class="persistent-card persistent-card--contacts">
    <a href={`${import.meta.env.BASE_URL}contacts/`}>
      <span>Contacts</span>
      <small>Email</small>
    </a>
  </article>

  {items.map((entry) => <ContentCard entry={entry} />)}
</main>
