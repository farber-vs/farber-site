---
import SiteLogo from "./SiteLogo.astro";
interface Props { title: string; category?: string; categoryLabel?: string; articlePath?: string; language?: "en"|"ru"; }
const {title,category,categoryLabel,articlePath,language="en"}=Astro.props;
const base=import.meta.env.BASE_URL;
---
<a class="skip-link" href="#main">{language==="ru" ? "К содержанию" : "Skip to content"}</a>
<header class="site-header" lang="en">
  <SiteLogo />
  {category ? <nav aria-label="Page navigation"><a href={`${base}?filter=${category}`}>{categoryLabel}</a>{category==="projects" && <span class="current-page">{title}</span>}</nav> : <span class="about-label">{title}</span>}
  {articlePath && <nav class="language-switcher" aria-label="Article language">
    <a href={articlePath} lang="en" hreflang="en" aria-label="English" aria-current={language==="en" ? "page":undefined}>EN</a><span aria-hidden="true">|</span>
    <a href={`${articlePath}ru/`} lang="ru" hreflang="ru" aria-label="Русский" aria-current={language==="ru" ? "page":undefined}>RU</a>
  </nav>}
</header>
