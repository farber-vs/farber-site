---
import { categories } from "../config/categories";
import SiteLogo from "./SiteLogo.astro";
---
<header class="site-header home-header">
  <SiteLogo />
  <nav class="filters" aria-label="Content filters">
    <a href={import.meta.env.BASE_URL} data-filter-link="show-all" aria-current="page">Show All</a>
    {categories.map(category => <a href={`${import.meta.env.BASE_URL}?filter=${category.slug}`} data-filter-link={category.slug}>{category.label}</a>)}
  </nav>
</header>
