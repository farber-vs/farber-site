---
import { Image } from "astro:assets";
import type {ImageMetadata} from "astro";
interface Props { src:ImageMetadata; alt:string; caption?:string; frame?:string; priority?:boolean; }
const {src,alt,caption,frame="",priority=false}=Astro.props;
---
<figure>
  <div class:list={["media-frame",frame]}><Image src={src} alt={alt} widths={[480,960,1440,1920]} sizes="(max-width:899px) 100vw, 90vw" loading={priority?"eager":"lazy"} fetchpriority={priority?"high":"auto"} /></div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
