---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import FilterBar from "../components/FilterBar.astro";
import HomepageGrid from "../components/HomepageGrid.astro";
import ImageViewer from "../components/ImageViewer.astro";
import "../styles/home.css";
const items = (await getCollection("items")).sort((a,b) => b.data.date.getTime()-a.data.date.getTime() || a.id.localeCompare(b.id));
---
<BaseLayout>
  <a class="skip-link" href="#main">Skip to content</a>
  <FilterBar />
  <HomepageGrid items={items} />
  <ImageViewer />
  <script>import "../scripts/filters.js";</script>
</BaseLayout>
