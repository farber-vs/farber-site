---
import { getEntry,render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import EditorialHeader from "../components/EditorialHeader.astro";
import EditorialFooter from "../components/EditorialFooter.astro";
import "../styles/about.css";
const entry=await getEntry("staticPages","about");
if(!entry) throw new Error("Missing about.mdx");
const {Content}=await render(entry);
---
<BaseLayout title={entry.data.title} description={entry.data.description}>
  <EditorialHeader title={entry.data.title} />
  <main id="main" class="page-shell about-page" tabindex="-1">
    <Content />
    <EditorialFooter email={true} />
  </main>
</BaseLayout>
